{
  "name": "@dijets/wallet-sdk",
  "version": "0.1.0",
  "description": "Wallets for Dijets: mnemonic, single-key, read-only (xpub) and experimental Ledger wallets over V-, M- and U-Chains, encrypted key files, native names and Arcs.",
  "private": true,
  "license": "BSD-3-Clause",
  "author": "Dijets Inc. Limited",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE.upstream"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "lint": "eslint .",
    "docs": "typedoc --out docs/api --entryPoints src/index.ts --tsconfig tsconfig.build.json --excludePrivate --readme none --name \"@dijets/wallet-sdk\""
  },
  "dependencies": {
    "@dijets/platform-js": "file:../dijets-platform-js",
    "bip32-path": "0.4.2",
    "bip39": "3.0.4",
    "bn.js": "5.2.5",
    "create-hash": "1.2.0",
    "ethers": "5.8.0"
  },
  "peerDependencies": {
    "@ledgerhq/hw-app-eth": ">=6.12.2",
    "@ledgerhq/hw-transport": ">=6.19.0",
    "@obsidiansystems/hw-app-avalanche": "0.2.2"
  },
  "peerDependenciesMeta": {
    "@ledgerhq/hw-app-eth": {
      "optional": true
    },
    "@ledgerhq/hw-transport": {
      "optional": true
    },
    "@obsidiansystems/hw-app-avalanche": {
      "optional": true
    }
  },
  "overrides": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/bn.js": "5.1.6",
    "@types/create-hash": "1.2.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typedoc": "0.27.6",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.2"
  }
}
